# Database - SQLite by default for local dev. Swap to a Postgres URL in production:
# DATABASE_URL="postgresql://user:password@host:5432/nvn_cars?schema=public"
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Seed admin (only used by prisma/seed.ts on first run)
SEED_ADMIN_EMAIL="admin@nvncars.iq"
SEED_ADMIN_PASSWORD="change-me-immediately"

# Server
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Image storage (optional - configure when moving off local/dev storage)
CLOUDINARY_URL=""

# Instagram (optional - manual content management is used until this is configured)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ACCOUNT_ID=""

# WhatsApp (optional, for future Business API integration)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
